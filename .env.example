# App
APP_NAME=Mobile Diagnostics API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# API
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000","http://127.0.0.1:8080"]

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mobile_diagnostics
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=dev-secret-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ADB (Android)
ADB_PATH=adb
ADB_TIMEOUT=30

# iOS (libimobiledevice)
IDEVICE_ID_PATH=idevice_id
IDEVICE_INFO_PATH=ideviceinfo
IDEVICE_BACKUP_PATH=idevicebackup2
IOS_TIMEOUT=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json